---
const { title = 'Expert Måleri | Måleri, fönster & fasad i Stockholm', description = 'Expert Måleri hjälper privatpersoner, företag, bostadsrättsföreningar och fastighetsägare med måleri, fönster och fasad i Stockholm.', active = '' } = Astro.props;
import { pages } from '../data/site';
const services = pages.filter((p) => ['maleri','fonstermalning-stockholm','fonsterrenovering-stockholm','fasadrenovering-stockholm','fasadarbete-stockholm'].includes(p.slug));
const company = pages.filter((p) => ['om-oss','projekt','vanliga-fragor'].includes(p.slug));
---
<!doctype html>
<html lang="sv">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f6f5f1" />
		<link rel="canonical" href={`https://www.expertmaleri.se${Astro.url.pathname}`} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Expert Måleri" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://images.unsplash.com" />
		<title>{title}</title>
	</head>
	<body>
		<div class="utility"><div class="wrap utility-inner"><span><b class="utility-spark">✳</b> Hantverk för hem och fastigheter i Stockholm</span><span><a href="mailto:info@expertmaleri.se">info@expertmaleri.se</a><i></i><a href="tel:+46707603051">0707–60 30 51</a></span></div></div>
		<header class="header"><div class="wrap nav">
			<a class="brand" href="/" aria-label="Expert Måleri startsida"><span class="brand-mark"><b>E</b><i></i></span><span class="brand-name"><strong>EXPERT</strong><b>MÅLERI</b><small>H. EXPERT MÅLERI AB</small></span></a>
			<button class="menu-toggle" aria-expanded="false" aria-label="Öppna meny"><span></span><span></span></button>
			<nav class="main-nav" aria-label="Huvudnavigation">
				<div class="nav-drop"><a href="/maleri/" class:list={['nav-link', active === 'services' && 'current']}>Tjänster <span class="chevron">⌄</span></a><div class="drop-panel">{services.map((p) => <a href={`/${p.slug}/`}>{p.title}<small>{p.short}</small></a>)}<a href="/renovering/">Renovering<small>Helhetsgrepp och samordning</small></a></div></div>
				<a class="nav-link" href="/projekt/">Projekt</a><a class="nav-link" href="/om-oss/">Om oss</a><a class="nav-link" href="/vanliga-fragor/">Frågor</a>
				<a class="button button-dark nav-cta" href="/kontakt/">Begär offert <span>↗</span></a>
			</nav>
		</div></header>
		<a class="floating-contact" href="/kontakt/" aria-label="Kontakta Expert Måleri"><span>✳</span><b>Prata om ditt projekt</b><i>↗</i></a>
		<main><slot /></main>
		<footer class="footer"><div class="footer-accent"></div><div class="wrap footer-top"><div class="footer-brand"><a class="brand brand-light" href="/"><span class="brand-mark"><b>E</b><i></i></span><span class="brand-name"><strong>EXPERT</strong><b>MÅLERI</b><small>H. EXPERT MÅLERI AB</small></span></a><p>Genomtänkt hantverk för fönster, fasader och rum. Vi hjälper dig från första samtal till färdigt resultat.</p><a class="footer-phone" href="tel:+46707603051">0707–60 30 51&nbsp; ↗</a></div>
			<div><h3>Tjänster</h3>{services.map((p) => <a href={`/${p.slug}/`}>{p.title.replace(' i Stockholm','')}</a>)}<a href="/renovering/">Renovering</a></div>
			<div><h3>Expert Måleri</h3>{company.map((p) => <a href={`/${p.slug}/`}>{p.title}</a>)}<a href="/malare-stockholm/">Målare Stockholm</a><a href="/malare-jarfalla/">Målare Järfälla</a><a href="/jobb/">Jobb</a></div>
			<div><h3>Kontakt</h3><a href="mailto:info@expertmaleri.se">info@expertmaleri.se</a><a href="tel:+46707603051">0707–60 30 51</a><p>Rektorsvägen 12<br/>177 39 Järfälla</p><a href="/kontakt/">Skicka en förfrågan ↗</a></div>
		</div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} H. Expert Måleri AB · Org.nr 556858-9245</span><span><a href="/miljo/">Miljö</a><a href="/personuppgiftspolicy/">Personuppgiftspolicy</a></span></div></footer>
		<script>
			const toggle = document.querySelector('.menu-toggle');
			toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); document.querySelector('.main-nav')?.classList.toggle('nav-open', open); document.body.classList.toggle('menu-open', open); });
			for (const item of document.querySelectorAll('.nav-drop > a')) item.addEventListener('click', (e) => { if (window.matchMedia('(max-width: 850px)').matches) { e.preventDefault(); item.parentElement?.classList.toggle('drop-open'); } });
			const floating = document.querySelector('.floating-contact');
			const updateFloat = () => floating?.classList.toggle('float-visible', window.scrollY > 360);
			window.addEventListener('scroll', updateFloat, { passive: true }); updateFloat();
			const revealTargets = document.querySelectorAll('.intro-body,.intro-stamp,.service-card,.feature-copy,.steps article,.project-heading,.project-collage,.audiences>div,.content-main,.project-cards .project-card,.faq-items details,.inquiry,.contact-info,.service-editorial figure,.service-process-grid article,.service-value-list article,.project-detail-body article');
			if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: 0.12 });
				revealTargets.forEach((el, index) => { el.classList.add('reveal-item'); el.style.setProperty('--reveal-delay', `${Math.min(index % 4, 3) * 70}ms`); observer.observe(el); });
			}
		</script>
		<style is:global>
		@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
		:root{--ink:#172b27;--muted:#66716b;--paper:#f6f5f1;--white:#fff;--line:#e1e2db;--green:#294a3b;--lime:#d8e568;--serif:Georgia,'Times New Roman',serif;--sans:'DM Sans',Arial,sans-serif;--display:Manrope,'DM Sans',sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}body.menu-open{overflow:hidden}a{color:inherit;text-decoration:none}button{font:inherit}.wrap{width:min(1240px,calc(100% - 64px));margin-inline:auto}.utility{height:36px;background:#203d32;color:#e3e8df;font-size:11px;letter-spacing:.035em}.utility-inner,.utility-inner>span:last-child{height:100%;display:flex;align-items:center;justify-content:space-between;gap:18px}.utility a{color:#f6f5ef}.utility i{width:3px;height:3px;border-radius:100%;background:#aab6a8}.header{height:82px;background:var(--paper);border-bottom:1px solid rgba(30,54,44,.1);position:relative;z-index:20}.nav{height:100%;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:10px;color:var(--ink)}.brand-symbol{font:800 43px/.8 var(--display);letter-spacing:-.12em;color:#244939}.brand-symbol span{color:#a9be50}.brand-name{font:800 14px/.95 var(--display);letter-spacing:.095em}.brand-name b{font-weight:500}.brand-name small{display:block;margin-top:5px;color:#768078;font:600 8px/1 var(--sans);letter-spacing:.16em}.main-nav{display:flex;align-items:center;gap:35px;height:100%}.nav-link{font-size:13px;font-weight:600;color:#31413b;transition:color .2s}.nav-link:hover{color:#789229}.chevron{font-size:16px;margin-left:4px}.nav-drop{height:100%;display:flex;align-items:center;position:relative}.drop-panel{position:absolute;top:70px;left:-22px;width:310px;padding:11px;background:#fff;box-shadow:0 18px 45px #172b271f;border:1px solid var(--line);border-radius:5px;display:none}.nav-drop:hover .drop-panel,.nav-drop:focus-within .drop-panel,.nav-drop.drop-open .drop-panel{display:block}.drop-panel a{display:block;padding:12px 13px;font-weight:650;font-size:13px;border-radius:3px}.drop-panel a:hover{background:#f5f6ef}.drop-panel small{display:block;color:#7a837c;font-size:10px;font-weight:400;margin-top:4px;line-height:1.4}.button{display:inline-flex;align-items:center;justify-content:center;gap:28px;padding:15px 19px;font-size:12px;font-weight:700;letter-spacing:.01em;border-radius:2px;transition:transform .2s,background .2s}.button:hover{transform:translateY(-2px)}.button-dark{color:#fff;background:#233f34}.button-dark:hover{background:#365c49}.button-lime{color:#1f322a;background:var(--lime)}.button-light{background:#fff;color:#22382f}.nav-cta{padding:14px 17px;gap:18px}.nav-cta span{font-size:17px}.menu-toggle{display:none}.footer{background:#18362c;color:#edf0e7;padding:75px 0 0}.footer-top{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:65px;padding-bottom:60px}.brand-light{color:#fff}.brand-light .brand-symbol{color:#fff}.brand-light .brand-name small{color:#a6b2a5}.footer-brand p{font-size:13px;color:#b7c1b8;line-height:1.75;max-width:270px;margin:26px 0 25px}.footer-phone{font:600 19px var(--display);color:#e2eb96}.footer h3{font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:#a9b6aa;margin:4px 0 20px}.footer-top>div:not(:first-child)>a{display:block;color:#eef1e9;font-size:12px;margin:13px 0}.footer-top>div>p{font-size:12px;color:#bdc5bd;line-height:1.8}.footer-bottom{border-top:1px solid #ffffff24;min-height:58px;display:flex;align-items:center;justify-content:space-between;font-size:10px;color:#aeb9af}.footer-bottom span:last-child{display:flex;gap:25px}.menu-toggle span{display:block}
		@media(max-width:850px){.wrap{width:min(100% - 40px,600px)}.utility{height:32px}.utility-inner>span:first-child{display:none}.utility-inner>span:last-child{margin-left:auto}.header{height:70px}.menu-toggle{border:0;background:transparent;width:40px;height:40px;display:grid;place-content:center;gap:5px;z-index:2}.menu-toggle span{width:22px;height:1.5px;background:var(--ink);transition:transform .2s}.menu-toggle[aria-expanded=true] span:first-child{transform:translateY(3.25px) rotate(45deg)}.menu-toggle[aria-expanded=true] span:last-child{transform:translateY(-3.25px) rotate(-45deg)}.main-nav{display:none;position:fixed;inset:102px 0 0;background:var(--paper);height:calc(100dvh - 102px);padding:27px 25px;align-items:stretch;gap:0;flex-direction:column;overflow:auto}.main-nav.nav-open{display:flex}.nav-link{font-size:20px;display:block;padding:15px 0;border-bottom:1px solid var(--line)}.nav-drop{display:block;height:auto}.chevron{float:right}.drop-panel{position:static;box-shadow:none;border:0;background:transparent;width:auto;padding:3px 0 10px 15px}.drop-panel a{padding:12px}.nav-cta{margin-top:23px}.footer-top{grid-template-columns:1fr 1fr;gap:38px 25px;padding-bottom:42px}.footer-brand{grid-column:span 2}.footer-bottom{padding:16px 0;align-items:flex-start;gap:15px;flex-direction:column}.footer-bottom span:last-child{gap:18px}}
		@media(max-width:450px){.wrap{width:calc(100% - 36px)}.utility{font-size:10px}.footer-top{gap:32px 18px}.footer-top>div:not(:first-child)>a,.footer-top>div>p{font-size:11px}}
		/* Campaign polish: richer wordmark, tactile controls, quiet motion and editorial depth */
		:root{--accent:#bf5e4a;--lime:#dfe879;--paper:#f5f3ec;--green:#183a2d;--shadow-soft:0 18px 50px #11261d1f}
		.header{position:sticky;top:0;height:92px;background:#f8f7f1f5;backdrop-filter:blur(16px);box-shadow:0 5px 24px #1c34220a;border-bottom:1px solid #263e3014}
		.nav{width:min(1310px,calc(100% - 80px))}.brand{gap:14px;padding:9px 0}.brand-mark{position:relative;width:49px;height:49px;border-radius:13px 13px 13px 4px;background:#1c3b2e;color:#f8f6ee;display:grid;place-items:center;box-shadow:inset 0 1px #ffffff32,0 5px 13px #19392c22;transform:rotate(-3deg)}.brand-mark b{font:800 32px/.85 var(--display);letter-spacing:-.1em;transform:rotate(3deg) translateX(-1px)}.brand-mark i{position:absolute;right:6px;bottom:6px;width:7px;height:7px;border-radius:100%;background:var(--accent);border:1px solid #f8f6ee}.brand-name{font:800 15px/.88 var(--display);letter-spacing:.1em;display:grid;grid-template-columns:auto auto;column-gap:5px;align-items:baseline}.brand-name strong{font-weight:800}.brand-name b{font-size:13px;font-weight:600;color:#4b6255}.brand-name small{grid-column:span 2;margin-top:6px;color:#747c72;font:700 7px/1 var(--sans);letter-spacing:.18em}.brand-light .brand-mark{background:#f3f2e9;color:#1c3b2e;box-shadow:none}.brand-light .brand-mark i{border-color:#f3f2e9}.brand-light .brand-name b{color:#c6d26b}.brand-light .brand-name small{color:#aebdaf}
		.utility{background:#19372b;height:34px}.utility-spark{color:#e2e981;font-size:11px;margin-right:8px}.main-nav{gap:31px}.nav-link{font-size:12px;letter-spacing:.01em}.nav-link:hover{color:var(--accent)}.nav-cta{border-radius:999px;padding:14px 18px 14px 21px;box-shadow:0 7px 15px #183a2d22}.button{border-radius:999px;padding:15px 22px;gap:18px;box-shadow:0 6px 13px #15261b0e}.button span{display:inline-grid;place-items:center;width:23px;height:23px;border-radius:100%;background:#ffffff40;font-size:15px;transition:transform .25s,background .25s}.button:hover{transform:translateY(-3px);box-shadow:0 11px 24px #15261b22}.button:hover span{transform:rotate(45deg);background:#ffffff75}.button-dark{background:linear-gradient(135deg,#244a39,#18392d)}.button-lime{background:linear-gradient(125deg,#e8ef8c,#d5e064)}.drop-panel{border-radius:12px;box-shadow:0 20px 55px #15271f29;padding:13px}.drop-panel a{border-radius:8px}
		.floating-contact{position:fixed;right:26px;bottom:24px;z-index:18;display:flex;align-items:center;gap:11px;padding:9px 10px 9px 15px;border:1px solid #ffffff8a;border-radius:999px;background:#f9f8f1ee;color:#19372b;box-shadow:0 10px 35px #13241e30;backdrop-filter:blur(14px);font-size:10px;opacity:0;transform:translateY(15px);pointer-events:none;transition:opacity .3s,transform .3s}.floating-contact.float-visible{opacity:1;transform:translateY(0);pointer-events:auto}.floating-contact span{display:grid;place-items:center;width:27px;height:27px;border-radius:100%;background:var(--accent);color:white}.floating-contact b{font-weight:700}.floating-contact i{font-style:normal;display:grid;place-items:center;border-radius:100%;width:26px;height:26px;background:#dfe879;font-size:14px;transition:transform .2s}.floating-contact:hover i{transform:rotate(45deg)}
		.footer{position:relative;overflow:hidden;background:radial-gradient(ellipse at 90% 0%,#315440 0%,transparent 36%),#15362a;padding-top:90px}.footer-accent{position:absolute;width:350px;height:350px;border:1px solid #dfe87924;border-radius:50%;right:-110px;top:-220px;box-shadow:0 0 0 34px #dfe8790c,0 0 0 69px #dfe87908}.footer-top{position:relative}.footer .brand{width:max-content}.footer-phone{display:inline-flex;border-bottom:1px solid #dfe87965;padding-bottom:8px}.footer-top>div:not(:first-child)>a{transition:color .2s,transform .2s}.footer-top>div:not(:first-child)>a:hover{color:#e4eb85;transform:translateX(3px)}
		.reveal-item{opacity:0;transform:translateY(22px);transition:opacity .65s ease var(--reveal-delay,0ms),transform .65s cubic-bezier(.2,.65,.25,1) var(--reveal-delay,0ms)}.reveal-item.is-visible{opacity:1;transform:translateY(0)}
		:focus-visible{outline:3px solid #bf5e4a;outline-offset:4px}.footer-bottom{border-color:#ffffff30}
		@media(max-width:850px){.header{height:78px}.nav{width:calc(100% - 36px)}.brand{gap:11px}.brand-mark{width:44px;height:44px;border-radius:11px 11px 11px 3px}.brand-mark b{font-size:29px}.brand-name{font-size:14px}.brand-name b{font-size:12px}.main-nav{inset:110px 0 0;height:calc(100dvh - 110px);background:#f5f3ecf7;backdrop-filter:blur(16px);padding:24px 24px 35px}.main-nav .nav-link{font-size:18px}.floating-contact{right:14px;bottom:14px;padding:7px 8px 7px 11px;gap:8px}.floating-contact b{font-size:9px}.footer{padding-top:65px}.reveal-item{transform:translateY(14px)}}
		@media(max-width:450px){.header{height:72px}.brand-mark{width:41px;height:41px}.brand-name{font-size:13px}.brand-name b{font-size:11px}.main-nav{inset:104px 0 0;height:calc(100dvh - 104px)}.floating-contact{bottom:12px;right:12px}}
		@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}.reveal-item{opacity:1;transform:none}}
		</style>
	</body>
</html>

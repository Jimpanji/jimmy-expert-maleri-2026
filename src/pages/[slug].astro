---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages, projects, faqs, projectDetails } from '../data/site';
import '../styles/editorial-services.css';
export function getStaticPaths() { return pages.map((page) => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props;
const serviceSlugs = ['maleri','fonstermalning-stockholm','fonsterrenovering-stockholm','fasadrenovering-stockholm','fasadarbete-stockholm','renovering','malare-stockholm','malare-jarfalla'];
const service = serviceSlugs.includes(page.slug);
const imageId = page.image || (page.slug === 'projekt' ? 'https://www-static.expertmaleri.se/wp-content/uploads/2024/09/Fasadrenovering.jpg' : page.slug === 'om-oss' || page.slug === 'jobb' ? 'https://www-static.expertmaleri.se/wp-content/uploads/2024/09/malare-stockholm.5132d6d0.jpg' : page.slug.includes('fasad') ? 'https://www-static.expertmaleri.se/wp-content/uploads/2024/09/Fasadarbete.jpg' : page.slug.includes('fonster') ? 'https://www-static.expertmaleri.se/wp-content/uploads/2024/09/Fonsterrenovering.jpg' : 'photo-1562259949-e8e7689d7828');
const image = imageId.startsWith('https://') ? imageId : `https://images.unsplash.com/${imageId}?auto=format&fit=crop&w=1400&q=82`;
const asset = (name: string) => `https://www-static.expertmaleri.se/wp-content/uploads/2024/09/${name}`;
const serviceImages: Record<string, { src: string; alt: string; caption: string }[]> = {
 'maleri': [
  { src: asset('malare-stockholm.5132d6d0.jpg'), alt: 'Målare i arbete i Stockholm', caption: 'Måleri · Stockholm' },
  { src: asset('malare-bagarmossen-05.webp'), alt: 'Måleriarbete i Bagarmossen', caption: 'Måleri · Bagarmossen' },
  { src: asset('malare-stockholm-02.webp'), alt: 'Måleriarbete i Stockholmsområdet', caption: 'Måleriarbete i Stockholm' },
 ],
 'fonstermalning-stockholm': [
  { src: asset('Fonstermalning.jpg'), alt: 'Fönstermålning av äldre fönster', caption: 'Fönstermålning' },
  { src: asset('malare-stockholm-02.webp'), alt: 'Målare i Stockholm vid ett fastighetsarbete', caption: 'Hantverk på plats' },
  { src: asset('Vi-utfor-fonstermalning-i-Stockholm.jpg'), alt: 'Pågående fönstermålning i Stockholm', caption: 'Fönster · Stockholm' },
 ],
 'fonsterrenovering-stockholm': [
  { src: asset('fonsterrenovering-stockholm-01.68e9f4eb.jpg'), alt: 'Fönsterrenovering i Stockholm', caption: 'Renovering · Stockholm' },
  { src: asset('Fonsterrenovering.jpg'), alt: 'Renoverat träfönster', caption: 'Varsamt bevarat' },
  { src: asset('Villa-Tradgardsblomman-Skalby-Jarfalla.jpg'), alt: 'Villa Trädgårdsblomman i Järfälla', caption: 'Villa Trädgårdsblomman' },
 ],
 'fasadrenovering-stockholm': [
  { src: asset('Fasadrenovering.jpg'), alt: 'Fasadrenovering av fastighet', caption: 'Fasadrenovering' },
  { src: asset('fasadrenovering-stockholm-1.webp'), alt: 'Fasadarbete på fastighet i Stockholm', caption: 'Fasad · Stockholm' },
  { src: asset('Nar-ar-det-dags-for-en-fasadrenovering.jpg'), alt: 'Fasad som ses över inför renovering', caption: 'Skick och underlag' },
 ],
 'fasadarbete-stockholm': [
  { src: asset('Fasadarbete.jpg'), alt: 'Fasadarbete på fastighet', caption: 'Fasadarbete' },
  { src: asset('Fasadrenovering.jpg'), alt: 'Fasadrenovering i Stockholmsområdet', caption: 'Fasadrenovering' },
  { src: asset('Fasadarbete-i-Stockholm-utfors-av-proffs.jpg'), alt: 'Utfört fasadarbete i Stockholm', caption: 'Stockholm med omnejd' },
 ],
 'renovering': [
  { src: asset('Fasadarbete.jpg'), alt: 'Renoveringsarbete på fastighet', caption: 'Renovering' },
  { src: asset('malare-bagarmossen-05.webp'), alt: 'Måleri- och renoveringsarbete', caption: 'Måleri & service' },
  { src: asset('Villa-Tradgardsblomman-Skalby-Jarfalla.jpg'), alt: 'Bostadsprojekt i Järfälla', caption: 'Järfälla' },
 ],
 'malare-stockholm': [
  { src: asset('malare-stockholm.5132d6d0.jpg'), alt: 'Målare i Stockholm', caption: 'Stockholm' },
  { src: asset('malare-stockholm-02.webp'), alt: 'Måleriarbete i Stockholmsområdet', caption: 'Måleri på plats' },
  { src: asset('malare-jarfalla-02-1.webp'), alt: 'Målare vid arbete i Järfälla', caption: 'Lokalt hantverk' },
 ],
 'malare-jarfalla': [
  { src: asset('malare-jarfalla-01.webp'), alt: 'Målare i Järfälla', caption: 'Järfälla' },
  { src: asset('malare-jarfalla-02-1.webp'), alt: 'Måleriarbete i Järfälla', caption: 'Måleri på plats' },
  { src: asset('Villa-Tradgardsblomman-Skalby-Jarfalla.jpg'), alt: 'Villa Trädgårdsblomman i Järfälla', caption: 'Villa Trädgårdsblomman' },
 ]
};
const serviceProcess: Record<string, [string,string][]> = {
 'maleri': [['Ytan gås igenom','Underlag, slitage och önskat slutresultat bedöms tillsammans.'],['Arbetet förbereds','Ytor skyddas och underlag lagas och förbereds efter behov.'],['Färg och utförande','Kulör och lämpliga produkter stäms av för projektet.'],['Målning & avstämning','Arbetet utförs omsorgsfullt och gås igenom med dig.']],
 'fonstermalning-stockholm': [['Skick bedöms','Vi går igenom bågar, karmar och tidigare färg.'],['Noggrant förarbete','Ytor skrapas och förbereds för ny färg.'],['Skyddande målning','Färgsystemet väljs utifrån underlag och väderutsatthet.'],['Genomgång','Vi går igenom färdigt arbete och eventuell fortsatt skötsel.']],
 'fonsterrenovering-stockholm': [['Märkning & planering','Bågar märks upp och arbetets omfattning gås igenom.'],['Renovering','Skadat trä, kitt och färg hanteras varsamt efter skick.'],['Ytbehandling','Grundning, målning och tätning utförs efter behov.'],['Återmontering','Bågar sätts tillbaka och resultatet stäms av med dig.']],
 'fasadrenovering-stockholm': [['Genomgång av fasaden','Material, skador, åtkomst och omfattning bedöms.'],['Förberedelse','Lösa partier och skador hanteras inför åtgärd.'],['Renovering','Lagning, puts eller målning görs utifrån fasadens behov.'],['Avslut & kontroll','Arbetet gås igenom och nästa underhåll kan planeras.']],
 'fasadarbete-stockholm': [['Behov & mål','Fastighetens skick och projektets mål klargörs.'],['Omfattning','Arbetet planeras efter fasadmaterial och förutsättningar.'],['Utförande','Åtgärder utförs med löpande samordning.'],['Slutgenomgång','Resultatet kontrolleras och överlämnas.']],
 'renovering': [['Samla behoven','Vi går igenom vilka arbeten och yrkesgrupper som behövs.'],['Planera helheten','Ordning, omfattning och samordning diskuteras.'],['Utför arbetet','Expert Måleri sköter måleri och överenskomna delar.'],['Följ upp','Vi stämmer av resultat och eventuella nästa steg.']],
 'malare-stockholm': [['Förfrågan','Du berättar om fastigheten och arbetet.'],['Bedömning','Omfattning och praktiska förutsättningar gås igenom.'],['Planering','Tidsplan och utförande stäms av.'],['Genomförande','Arbetet görs med löpande dialog.']],
 'malare-jarfalla': [['Berätta om jobbet','Vi börjar med plats, ytor och önskat resultat.'],['Se över ytorna','Underlaget gås igenom före arbetets start.'],['Kom överens','Omfattning och plan stäms av.'],['Måla & följ upp','Vi genomför arbetet och går igenom det tillsammans.']]
};
const processItems = serviceProcess[page.slug] || [];
const selectedServiceImages = serviceImages[page.slug] || [];
const featuredProject: Record<string,string> = {
 'maleri':'Alba Nova · trapphusmålning och arbeten i bibliotek',
 'fonstermalning-stockholm':'Bromma kyrka · renovering av äldre träfönster',
 'fonsterrenovering-stockholm':'Engelbrektskyrkan · fönsterrenovering och kittning',
 'fasadrenovering-stockholm':'Fasad- och fönsterarbeten · Stockholm med omnejd',
 'fasadarbete-stockholm':'Fasad- och fönsterarbeten · Stockholm med omnejd',
 'renovering':'Vetenskapens Hus · arbeten vid totalrenovering',
 'malare-stockholm':'Vetenskapens Hus · måleriarbeten i Vasastan',
 'malare-jarfalla':'Villa Trädgårdsblomman · Järfälla'
};
const paragraphs: Record<string,string[]> = {
 'maleri':['H. Expert Måleri utför måleri och tapetsering i Stockholm med omnejd. Vi hjälper till vid nyproduktion, ombyggnad, service och när hem eller lokaler behöver ett nytt uttryck.','Vi arbetar invändigt och utvändigt, med bland annat väggar, tak, dörrar och snickerier. Trapphusmålning är också en del av vårt arbete – från mindre fastigheter till större hus.','Förberedelsen är viktig för slutresultatet. Vi går igenom underlaget och projektets förutsättningar innan vi kommer överens om arbetets omfattning.'],
 'fonstermalning-stockholm':['Fönster utsätts för väder och slitage. När färgen börjar flagna eller träet ser torrt ut kan en genomtänkt ommålning skydda fönstret och lyfta fastighetens helhetsintryck.','Vi målar fönster åt privatpersoner och fastighetsägare i Stockholmsområdet. Metod och omfattning anpassas efter material, skick och tidigare behandling.','Är du osäker på om fönstren behöver målas eller renoveras? Vi hjälper dig att bedöma vad som passar projektet.'],
 'fonsterrenovering-stockholm':['Fönsterrenovering är ett sätt att ta hand om befintliga fönster och bevara byggnadens uttryck. Vi hjälper privatpersoner, bostadsrättsföreningar och fastighetsägare i Stockholm med renovering utifrån fönstrens skick.','Arbetet kan omfatta skrapning och förberedelse, lagning av skadat trä, nytt kitt, målning och tätning. Vid behov går vi även igenom glas, foder och bleck. Vilka insatser som är lämpliga beror på fönstrens konstruktion och skick.','På tidigare projekt har fönsterbågar märkts upp och renoverats i verkstad, med skydd av öppningar under tiden. Vi går igenom upplägget med dig inför varje projekt.'],
 'fasadrenovering-stockholm':['En väl omhändertagen fasad skyddar byggnaden och bidrar till fastighetens uttryck. Vi hjälper till med fasadrenovering i Stockholm, från lokala lagningar till mer omfattande arbeten.','Arbeten kan handla om att laga sprickor och skador, måla om, putsa om eller renovera fasadytor av trä, tegel eller puts. Vi ser till fasadens skick och förutsättningar innan vi föreslår omfattning.','Kostnaden påverkas bland annat av fasadens storlek, material, skick och åtkomst. Kontakta oss så pratar vi igenom fastigheten och nästa steg.'],
 'fasadarbete-stockholm':['Fasadarbete kan vara allt från en avgränsad reparation till en större renovering av fastigheten. H. Expert Måleri hjälper privatpersoner, bostadsrättsföreningar och fastighetsägare i Stockholmsområdet.','Vi arbetar med puts-, trä- och tegelfasader. Beroende på behov kan arbetet omfatta spricklagning, ommålning, omputsning och andra renoveringsinsatser.','Vi börjar med att förstå byggnadens skick, önskemål och praktiska förutsättningar. Därefter kan vi ge en tydligare bild av lämpligt upplägg.'],
 'renovering':['H. Expert Måleri utför måleriarbeten i samband med nyproduktion, ombyggnad, renovering och service. Vi hjälper till med helhetsgrepp kring måleri och fasad- eller fönsterarbeten.','När ett projekt behöver fler yrkesgrupper samarbetar vi med hantverkare inom bland annat snickeri. VVS, el och ventilation kan samordnas genom samarbetspartners.','Berätta vad som ska göras och vilka delar du vill ha hjälp med, så går vi igenom en möjlig väg framåt.'],
 'malare-stockholm':['Våra målare utgår från Järfälla och utför arbeten i hela Stockholmsområdet. Vi arbetar med privatpersoner, företag, bostadsrättsföreningar och fastighetsägare.','Vi hjälper med inomhus- och utomhusmålning, tapetsering, trapphus, fönster och fasad. För större fastigheter kan vi planera omfattning och arbetets genomförande tillsammans med beställaren.','Skicka gärna en kort beskrivning av fastigheten och arbetet du funderar på. Vi återkommer om hur vi kan hjälpa till.'],
 'malare-jarfalla':['H. Expert Måleri utgår från Järfälla och hjälper kunder i kommunen och runt om i Stockholm. Vi arbetar med allt från måleri inomhus till fönster- och fasadarbeten.','Privatpersoner, företag och bostadsrättsföreningar kan vända sig till oss för mindre arbeten och större projekt. Vi pratar igenom omfattningen och vad som behöver göras innan arbetet planeras.','Vi har tidigare arbetat med projekt i Järfälla, bland annat bostäder i Trädgårdsblomman, Vattmyra Äng och Skälby.']
};
const defaultParas: Record<string,string[]> = {
 'om-oss':['H. Expert Måleri AB är ett måleriföretag som arbetar med måleri, fönsterrenovering, fasadrenovering och servicejobb i Stockholm med omnejd.','Vi hjälper privatpersoner, fastighetsägare, bostadsrättsföreningar och företag. Vårt mål är att utföra arbetet med kvalitet och servicekänsla – och att vårda långsiktiga relationer med våra uppdragsgivare.','Vi använder kvalitetsmaterial från ledande färgleverantörer. Företaget uppger att det har F-skatt och erforderliga ansvars- och trygghetsförsäkringar.'],
 'jobb':['Vi är intresserade av självgående, erfarna hantverkare inom måleri, fasadrenovering och fönsterrenovering. Vi söker personer med yrkesstolthet och god social förmåga.','Skicka en kort presentation av dig själv och din erfarenhet till info@expertmaleri.se. Berätta gärna vilken typ av arbeten du helst utför.'],
 'miljo':['Vi använder miljöklassade produkter och tar hänsyn till gällande rekommendationer för måleri, miljö och arbetsmiljö. Val av färg och metod anpassas efter underlaget och projektets behov.','Fråga oss gärna om materialval inför ditt projekt.'],
 'personuppgiftspolicy':['När du kontaktar oss kan du lämna uppgifter som namn, telefonnummer, e-postadress och information om ditt projekt. Vi använder uppgifterna för att hantera din förfrågan och kommunicera med dig.','För frågor om personuppgifter, kontakta info@expertmaleri.se eller skriv till H. Expert Måleri AB, Rektorsvägen 12, 177 39 Järfälla.']
};
const text = paragraphs[page.slug] || defaultParas[page.slug] || [];
---
<SiteLayout title={`${page.title} | Expert Måleri`} description={`${page.short} H. Expert Måleri arbetar i Stockholm med omnejd.`} active={service ? 'services' : ''}>
{page.slug === 'projekt' ? <>
  <section class="page-hero project-hero"><div class="page-hero-photo" style={`background-image:url('${image}')`}></div><div class="page-hero-overlay"></div><div class="wrap page-hero-content"><a class="crumb" href="/">START <span>/</span> PROJEKT</a><span class="eyebrow light"><span></span> UTVALDA REFERENSER</span><h1>{page.title}<br/><em>i verkligheten.</em></h1><p>{page.short}</p></div><div class="page-hero-badge"><span>01 / 13</span><b>Arbeten runt<br/>Stockholms län</b><i>↗</i></div></section>
  <section class="projects-list wrap"><div class="list-intro"><span class="eyebrow"><span></span> STOCKHOLM MED OMNEJD</span><p>Projekt inom fönsterrenovering, fasad, trapphusmålning och andra måleriarbeten.</p></div><div class="project-cards">{projects.map(([name,desc],i)=><a class="project-card" href={`/projekt/${projectDetails[i].slug}/`}><div class="project-card-photo" style={`background-image:url('${asset(projectDetails[i].image)}')`}></div><div class="project-card-shade"></div><div class="project-count">{String(i+1).padStart(2,'0')} <span> / 13</span></div><h2>{name}</h2><p>{desc}</p><span class="project-arrow">↗</span></a>)}</div></section>
</> : page.slug === 'vanliga-fragor' ? <>
  <section class="page-hero faq-hero"><div class="page-hero-photo" style={`background-image:url('${image}')`}></div><div class="page-hero-overlay"></div><div class="wrap page-hero-content"><a class="crumb" href="/">START <span>/</span> VANLIGA FRÅGOR</a><span class="eyebrow light"><span></span> BRA ATT VETA</span><h1>Vanliga frågor<br/><em>och svar.</em></h1><p>{page.short}</p></div></section><section class="faq-list wrap"><div class="faq-side"><span class="eyebrow"><span></span> HJÄLP & INFORMATION</span><h2>Undrar du<br/>över något?</h2><p>Hittar du inte svaret här? Hör av dig så pratar vi igenom ditt projekt.</p><a class="text-link" href="/kontakt/">Kontakta oss <span>↗</span></a></div><div class="faq-items">{faqs.map(([q,a],i)=><details open={i===0}><summary><span>{String(i+1).padStart(2,'0')}</span>{q}<b>+</b></summary><p>{a}</p></details>)}</div></section>
</> : <>
  <section class="page-hero"><div class="page-hero-photo" style={`background-image:url('${image}')`}></div><div class="page-hero-overlay"></div><div class="wrap page-hero-content"><a class="crumb" href="/">START <span>/</span> {page.title.toUpperCase()}</a><span class="eyebrow light"><span></span> {service ? page.group.toUpperCase() + ' · STOCKHOLM' : page.group.toUpperCase()}</span><h1>{page.title.split(' i ')[0]}{page.title.includes(' i ') && <><br/><em>i {page.title.split(' i ')[1]}.</em></>}</h1><p>{page.short}</p>{service && <a class="button button-lime" href="/kontakt/">Be om offert <span>↗</span></a>}</div><div class="page-hero-badge"><span>EXPERT MÅLERI</span><b>Hantverk som<br/>håller längre.</b><i>✳</i></div></section>
  <section class="content-section wrap"><aside class="content-aside"><span class="eyebrow"><span></span> {service ? 'EXPERT MÅLERI' : 'H. EXPERT MÅLERI AB'}</span><div class="aside-rule"></div><p>Hantverk för hem och fastigheter i Stockholm med omnejd.</p><a href="tel:+46707603051">0707–60 30 51 <span>↗</span></a></aside><article class="content-main">{text.map((paragraph)=><p>{paragraph}</p>)}
  {service && <><h2>Hantverk utifrån fastighetens behov</h2><p>Vi går igenom underlag, skick och praktiska förutsättningar innan vi föreslår omfattning. Arbetet formas efter ytan och projektet.</p><div class="service-facts"><span>Privatpersoner</span><span>Bostadsrättsföreningar</span><span>Företag & fastighetsägare</span></div><h2>En tydlig dialog från start</h2><p>Du får prata igenom dina frågor och önskemål med oss. Vi planerar arbetet i dialog och stämmer av viktiga delar längs vägen.</p></>}
  {page.slug === 'om-oss' && <><div class="people-feature"><div class="people-photo" style={`background-image:url('https://www-static.expertmaleri.se/wp-content/uploads/2024/09/malare-stockholm.5132d6d0.jpg')`}></div><div class="people-tag"><span>H. EXPERT MÅLERI</span><b>Människorna<br/>bakom hantverket.</b></div></div><div class="content-callout"><span>H. EXPERT MÅLERI AB</span><b>Kvalitet, servicekänsla och långsiktiga relationer.</b><p>Vi arbetar efter vårt motto: bli klara i tid, till utlovat pris och med bästa kvalitet.</p><a href="/projekt/">Se våra referenser ↗</a></div></>}
  {page.slug === 'jobb' && <div class="content-callout"><span>INTRESSERAD?</span><b>Berätta om din erfarenhet.</b><p>Vi tar gärna emot en kort presentation via e-post.</p><a href="mailto:info@expertmaleri.se?subject=Jobb%20hos%20Expert%20M%C3%A5leri">info@expertmaleri.se ↗</a></div>}
  {page.slug === 'personuppgiftspolicy' && <><h2>Dina rättigheter</h2><p>Du kan kontakta oss för att få information om de personuppgifter vi hanterar eller för att begära rättelse eller radering där det är tillämpligt.</p></>}
  </article></section>
</>}
{service && <section class="service-editorial">
  <div class="service-photo-intro wrap"><div class="service-photo-title"><span class="eyebrow"><span></span> {page.title.toUpperCase()}</span><h2>Omsorg om<br/><em>varje detalj.</em></h2><p>Rätt material och ett noggrant utförande gör skillnaden. Se exempel på arbeten och miljöer ur Expert Måleris bildarkiv.</p></div><figure class="editorial-main"><img src={selectedServiceImages[0]?.src} alt={selectedServiceImages[0]?.alt} loading="lazy" decoding="async"/><figcaption>{selectedServiceImages[0]?.caption}</figcaption></figure><figure class="editorial-inset"><img src={selectedServiceImages[1]?.src} alt={selectedServiceImages[1]?.alt} loading="lazy" decoding="async"/><figcaption>{selectedServiceImages[1]?.caption}</figcaption></figure><figure class="editorial-detail"><img src={selectedServiceImages[2]?.src} alt={selectedServiceImages[2]?.alt} loading="lazy" decoding="async"/><figcaption>{selectedServiceImages[2]?.caption}</figcaption></figure></div>
  <div class="service-process-band"><div class="wrap"><div class="service-process-head"><span class="eyebrow light"><span></span> FRÅN FÖRSTA GENOMGÅNG TILL FÄRDIGT ARBETE</span><h2>En arbetsgång<br/><em>du kan följa.</em></h2><p>Vi anpassar detaljerna efter fastighet och uppdrag. Grunden är att du vet vad som händer och varför.</p></div><div class="service-process-grid">{processItems.map(([heading,copy],i)=><article><span>0{i+1}</span><h3>{heading}</h3><p>{copy}</p></article>)}</div></div></div>
  <div class="service-value wrap"><div class="service-value-heading"><span class="eyebrow"><span></span> VAD VI TAR HÄNSYN TILL</span><h2>Kvalitet sitter<br/>i <em>förarbetet.</em></h2></div><div class="service-value-list"><article><span>01</span><div><h3>Material & skick</h3><p>Vi väljer arbetssätt efter underlaget, ytan och vad fastigheten behöver.</p></div></article><article><span>02</span><div><h3>Omsorg i utförandet</h3><p>Förberedelser och detaljer får den tid de behöver för ett väl sammanhållet resultat.</p></div></article><article><span>03</span><div><h3>Samspel med fastigheten</h3><p>Vi tar hänsyn till byggnadens uttryck och hur arbetet påverkar de som använder den.</p></div></article></div></div>
  <div class="service-reference wrap"><div class="reference-photo" style={`background-image:url('${selectedServiceImages[2]?.src}')`}></div><div class="reference-copy"><span class="eyebrow"><span></span> UR REFERENSARKIVET</span><h2>{featuredProject[page.slug]}</h2><p>Expert Måleris uppdrag omfattar arbeten i bostäder, kyrkor, forskningslokaler och fastigheter i Stockholmsområdet.</p><a href="/projekt/" class="reference-link">Se hela projektarkivet <span>↗</span></a></div></div>

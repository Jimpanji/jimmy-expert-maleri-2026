---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages, projects } from '../data/site';
const services = pages.filter((p) => ['fonsterrenovering-stockholm','fasadrenovering-stockholm','fasadarbete-stockholm','maleri','fonstermalning-stockholm','renovering'].includes(p.slug));
const photo = (id: string, w = 1000) => id.startsWith('https://') ? id : `https://images.unsplash.com/${id}?auto=format&fit=crop&w=${w}&q=82`;
---
<SiteLayout title="Expert Måleri | Fönster, fasad & måleri i Stockholm" description="Fönsterrenovering, fasadrenovering och måleri i Stockholm. Expert Måleri hjälper privatpersoner, BRF:er, företag och fastighetsägare.">
	<section class="hero"><div class="hero-image" style={`background-image:url('${photo('https://www-static.expertmaleri.se/wp-content/uploads/2024/09/malare-stockholm.5132d6d0.jpg',1800)}')`}></div><div class="hero-shade"></div><div class="hero-frame"></div><div class="wrap hero-content"><div class="eyebrow light"><span></span> H. EXPERT MÅLERI · STOCKHOLM</div><h1>Vi tar hand om<br/>det som <em>håller.</em></h1><p>Fönster, fasader och måleri med hantverket i fokus. För hem och fastigheter i hela Stockholmsområdet.</p><div class="hero-actions"><a href="/kontakt/" class="button button-lime">Berätta om ditt projekt <span>↗</span></a><a href="tel:+46707603051" class="call-link">Ring oss <b>0707–60 30 51</b></a></div><div class="hero-index"><span>01 / 03</span><span class="index-line"></span><span>HANTVERK SOM BESTÅR</span></div></div><div class="hero-note"><span>01</span><span>FÖNSTER · FASAD · MÅLERI</span></div><div class="hero-float"><span>HANTVERK I STOCKHOLM</span><b>Gjord för att hålla.</b><i>↗</i></div><div class="hero-mark">H.</div></section>
	<div class="trust-strip"><div class="wrap trust-inner"><span><i>✳</i> Privatpersoner</span><span><i>✳</i> Bostadsrättsföreningar</span><span><i>✳</i> Företag</span><span><i>✳</i> Fastighetsägare</span><span class="trust-area">Stockholm med omnejd</span></div></div>
	<section class="intro section wrap"><div class="intro-label"><span class="eyebrow"><span></span> MER ÄN MÅLERI</span><span class="vertical-note">01 — EXPERTIS</span></div><div class="intro-body"><h2>Fastigheten förtjänar<br/>ett <em>långt liv.</em></h2><p class="lead">Vi hjälper dig att ta hand om husets viktiga ytor. Med särskilt fokus på fönster och fasad – och ett lika säkert handlag inomhus.</p><p class="copy">Från fönster som behöver varsam renovering till en fasad som behöver nytt skydd. Vi planerar arbetet tillsammans med dig och håller ihop det hela vägen.</p><a class="text-link" href="/om-oss/">Lär känna Expert Måleri <span>↗</span></a></div><div class="intro-stamp"><b>H.</b><span>HANTVERK<br/>MED OMSORG</span></div></section>
	<section class="expertise"><div class="wrap"><div class="section-head"><div><span class="eyebrow"><span></span> VAD VI GÖR</span><h2>Rätt hantverk.<br/><em>Rätt från början.</em></h2></div><p>Olika material kräver olika kunskap. Vi börjar med att förstå fastigheten – sedan tar vi fram rätt väg framåt.</p></div><div class="service-grid">
		{services.map((s, i) => <a class:list={['service-card', `service-${i + 1}`]} href={`/${s.slug}/`}><div class="service-photo" style={`background-image:url('${photo(s.image,1000)}')`}></div><span class="service-number">0{i + 1}</span><div class="service-card-content"><span>{s.group}</span><h3>{s.title.replace(' i Stockholm','')}</h3><p>{s.short}</p><b class="round-arrow">↗</b></div></a>)}
	</div><div class="section-foot"><span>Från mindre arbeten till samordnade fastighetsprojekt.</span><a class="text-link" href="/kontakt/">Beskriv ditt projekt <span>↗</span></a></div></div></section>
	<section class="window-feature"><div class="feature-photo" style={`background-image:url('${photo('https://www-static.expertmaleri.se/wp-content/uploads/2024/09/Fonsterrenovering.jpg',1200)}')`}><span class="photo-caption">FÖNSTERRENOVERING · STOCKHOLM</span><div class="photo-medallion"><span>VARSAMT</span><b>renoverat</b><span>FÖNSTERHANTVERK</span></div></div><div class="feature-copy"><span class="eyebrow light"><span></span> SPECIALISTOMRÅDE</span><h2>Bevara det<br/>som är <em>värt att spara.</em></h2><p>Äldre fönster bär på husets karaktär. Med rätt renovering kan de fortsätta göra sitt jobb i många år till.</p><p>Vi ser över skick och behov, och hjälper till med renovering, kittning, målning och tätning. För privatpersoner, bostadsrättsföreningar och fastighetsägare.</p><a class="button button-lime" href="/fonsterrenovering-stockholm/">Om fönsterrenovering <span>↗</span></a><a class="feature-secondary" href="/fonstermalning-stockholm/">Behöver fönstren målas? <span>→</span></a></div></section>
	<section class="process section wrap"><div class="process-head"><span class="eyebrow"><span></span> SÅ GÅR DET TILL</span><h2>En tydlig väg till<br/><em>ett hållbart resultat.</em></h2></div><div class="steps"><article><span>01</span><h3>Vi lyssnar</h3><p>Du berättar vad fastigheten behöver. Vi ställer frågor och reder ut omfattningen.</p></article><article><span>02</span><h3>Vi går igenom</h3><p>Vi tittar på ytor, material och förutsättningar och föreslår ett rimligt upplägg.</p></article><article><span>03</span><h3>Vi utför</h3><p>Arbetet genomförs med omsorg och löpande dialog från start till avslut.</p></article></div></section>
	<section class="project-band"><div class="wrap project-inner"><div class="project-heading"><span class="eyebrow light"><span></span> UTVALDA REFERENSER</span><h2>Hantverk i<br/><em>verkligheten.</em></h2><p>Vi är stolta över att ha fått bidra till fastigheter, hem och miljöer runt om i Stockholmsområdet.</p><a class="button button-light" href="/projekt/">Se våra projekt <span>↗</span></a></div><div class="project-collage"><div class="project-image project-image-main" style={`background-image:url('${photo('https://www-static.expertmaleri.se/wp-content/uploads/2024/09/Fasadrenovering.jpg',1000)}')`}><span>FASADRENOVERING</span></div><div class="project-image project-image-small" style={`background-image:url('${photo('https://www-static.expertmaleri.se/wp-content/uploads/2024/09/fonsterrenovering-stockholm-01.68e9f4eb.jpg',700)}')`}><span>FÖNSTERHANTVERK</span></div><div class="project-caption"><b>13</b><span>REFERENSER<br/>FRÅN STOCKHOLM</span><a href="/projekt/">↗</a></div></div></div></section>
	<section class="audiences section wrap"><div><span class="eyebrow"><span></span> FÖR VEM VI ARBETAR</span><h2>En partner att<br/><em>räkna med.</em></h2><p class="lead">Behoven ser olika ut. Vårt engagemang för ett väl utfört arbete gör det inte.</p></div><div class="audience-list"><a href="/kontakt/"><span>01</span><b>Privatpersoner</b><small>Hjälp med hemmet, från enstaka rum till fönster och fasad.</small><i>↗</i></a><a href="/kontakt/"><span>02</span><b>Bostadsrättsföreningar</b><small>Arbeten i gemensamma utrymmen och på fastighetens yttre.</small><i>↗</i></a><a href="/kontakt/"><span>03</span><b>Företag & fastighetsägare</b><small>Underhåll och renovering för lokaler och fastighetsbestånd.</small><i>↗</i></a></div></section>
	<section class="contact-band"><div class="wrap contact-inner"><div><span class="eyebrow light"><span></span> NÄSTA STEG</span><h2>Vad behöver<br/>din fastighet?</h2></div><p>Berätta kort vad du funderar på. Vi hjälper dig att hitta rätt nästa steg.</p><a class="button button-lime" href="/kontakt/">Prata med oss <span>↗</span></a><span class="contact-ornament">E.</span></div></section>
</SiteLayout>


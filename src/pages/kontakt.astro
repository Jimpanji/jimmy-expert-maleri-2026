---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Kontakta Expert Måleri | Begär offert" description="Kontakta Expert Måleri om måleri, fönsterrenovering eller fasadarbete i Stockholm.">
<section class="contact-hero"><div class="contact-image"></div><div class="contact-overlay"></div><div class="wrap contact-hero-inner"><a class="crumb" href="/">START <span>/</span> KONTAKT</a><span class="eyebrow light"><span></span> VI HJÄLPER DIG VIDARE</span><h1>Berätta om<br/><em>ditt projekt.</em></h1><p>Fönster, fasad eller måleri – hör av dig så pratar vi igenom vad du behöver.</p></div><div class="contact-badge"><span>H. EXPERT MÅLERI</span><b>En personlig<br/>kontakt hela vägen.</b><i>✳</i></div></section>
<section class="contact-main wrap"><div class="contact-info"><span class="eyebrow"><span></span> H. EXPERT MÅLERI AB</span><h2>Vi börjar med<br/>ett samtal.</h2><p>Ring eller mejla oss direkt, eller skicka en förfrågan med formuläret. Berätta gärna var fastigheten finns och vad du vill ha hjälp med.</p><a class="direct" href="tel:+46707603051"><small>TELEFON</small><b>0707–60 30 51</b><span>↗</span></a><a class="direct" href="mailto:info@expertmaleri.se"><small>E-POST</small><b>info@expertmaleri.se</b><span>↗</span></a><div class="address"><small>BESÖKSADRESS</small><p>Rektorsvägen 12<br/>177 39 Järfälla</p></div></div>
<form class="inquiry" action="mailto:info@expertmaleri.se" method="post" enctype="text/plain"><span class="eyebrow"><span></span> SKICKA EN FÖRFRÅGAN</span><h2>Vad kan vi hjälpa dig med?</h2><label>Ditt namn<input name="Namn" autocomplete="name" required placeholder="För- och efternamn"/></label><div class="form-row"><label>E-post<input type="email" name="E-post" autocomplete="email" required placeholder="namn@exempel.se"/></label><label>Telefon<input type="tel" name="Telefon" autocomplete="tel" placeholder="07X XXX XX XX"/></label></div><label>Vad gäller projektet?<select name="Ämne"><option value="">Välj område</option><option>Fönsterrenovering</option><option>Fönstermålning</option><option>Fasadrenovering / fasadarbete</option><option>Måleri / tapetsering</option><option>Annat eller flera arbeten</option></select></label><label>Meddelande<textarea name="Meddelande" rows="4" required placeholder="Beskriv gärna fastigheten och arbetet du funderar på."></textarea></label><label class="consent"><input type="checkbox" required/><span>Jag godkänner att Expert Måleri använder mina uppgifter för att hantera min förfrågan. Läs vår <a href="/personuppgiftspolicy/">personuppgiftspolicy</a>.</span></label><button class="button button-dark" type="submit">Skicka förfrågan <span>↗</span></button><p class="form-note">Formuläret öppnar ditt e-postprogram för att skicka meddelandet.</p></form></section>
<section class="contact-foot"><div class="wrap"><span>H. EXPERT MÅLERI AB</span><span>Org.nr 556858-9245</span><span>Stockholm med omnejd · Utgår från Järfälla</span></div></section>
</SiteLayout>
<style>
.contact-hero{height:390px;position:relative;background:#1d392e;color:white;overflow:hidden}.contact-image{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1600&q=82') center 52%/cover}.contact-overlay{position:absolute;inset:0;background:linear-gradient(90deg,#173127e8,#17312785 57%,#1731271c)}.contact-hero-inner{position:relative;padding-top:33px}.crumb{display:block;margin-bottom:45px;color:#c1cbbf;font-size:8px;letter-spacing:.15em}.crumb span{padding:0 9px;color:#d8e568}.eyebrow{display:flex;align-items:center;gap:10px;color:#68756d;font-size:9px;letter-spacing:.19em;font-weight:700}.eyebrow>span{width:19px;height:1px;background:#a5ba50}.eyebrow.light{color:#d9e0d6}.contact-hero h1{font:500 65px/.96 var(--display);letter-spacing:-.07em;margin:15px 0}.contact-hero h1 em{font:400 .95em Georgia,serif}.contact-hero-inner>p{font-size:12px;color:#d5ded4}.contact-main{display:grid;grid-template-columns:.8fr 1.2fr;gap:100px;padding-block:80px 105px}.contact-info h2,.inquiry h2{font:600 36px/1.1 var(--display);letter-spacing:-.05em;margin:22px 0 15px}.contact-info>p{font-size:12px;line-height:1.8;color:#6c786e;max-width:310px;margin-bottom:29px}.direct{display:grid;grid-template-columns:1fr 20px;gap:4px;padding:14px 0;border-top:1px solid #dfe2da}.direct small,.address small{grid-column:span 2;font-size:8px;letter-spacing:.14em;color:#89934d}.direct b{font:600 14px var(--display)}.direct span{grid-column:2;grid-row:2;color:#889646}.address{margin-top:21px}.address p{font-size:12px;line-height:1.7;color:#68746a}.inquiry{padding:30px;background:#e9eae3}.inquiry h2{font-size:27px;margin:17px 0 25px}.inquiry label{display:block;font-size:9px;font-weight:700;color:#42534a;margin-bottom:15px}.inquiry input:not([type=checkbox]),.inquiry select,.inquiry textarea{display:block;width:100%;margin-top:7px;border:1px solid #d4d9cf;background:#f8f8f4;padding:12px 13px;color:#253930;font:11px var(--sans);outline:none;border-radius:0}.inquiry input:focus,.inquiry select:focus,.inquiry textarea:focus{border-color:#7e9141}.inquiry textarea{resize:vertical}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:13px}.inquiry .consent{display:flex;align-items:flex-start;gap:9px;font-size:9px;font-weight:400;line-height:1.6;color:#69746a}.consent input{margin-top:2px;accent-color:#294a3b}.consent a{text-decoration:underline}.inquiry button{border:0;cursor:pointer}.form-note{font-size:9px;color:#7b847b}.contact-foot{background:#203e32;color:#c9d2c8}.contact-foot>.wrap{display:flex;justify-content:space-between;padding-block:19px;font-size:8px;letter-spacing:.1em}@media(max-width:800px){.contact-main{grid-template-columns:1fr;gap:35px;padding-block:55px 75px}.contact-info{display:grid;grid-template-columns:1fr 1fr;gap:0 22px}.contact-info>.eyebrow,.contact-info h2,.contact-info>p{grid-column:span 2}.direct{align-content:start}.address{grid-column:span 2}.contact-foot>.wrap{flex-wrap:wrap;gap:8px 20px}}@media(max-width:520px){.contact-hero{height:360px}.contact-hero h1{font-size:53px}.contact-info h2{font-size:32px}.inquiry{padding:22px 17px}.inquiry h2{font-size:24px}.form-row{grid-template-columns:1fr;gap:0}}
</style>

<style>
.contact-hero{height:440px;isolation:isolate;overflow:visible;z-index:1}.contact-image{background-image:url('https://www-static.expertmaleri.se/wp-content/uploads/2024/09/malare-jarfalla-02-1.webp');background-position:center 43%;filter:saturate(.8);transform:scale(1.02)}.contact-overlay{background:linear-gradient(90deg,#152f26f2 0%,#152f26b0 43%,#152f2622 100%),linear-gradient(0deg,#132a224c,transparent 50%)}.contact-hero:after{content:'';position:absolute;inset:15px;border:1px solid #ffffff36;pointer-events:none}.contact-hero-inner{padding-top:38px}.contact-hero h1{font-size:74px;text-shadow:0 4px 24px #10251f70}.contact-hero h1 em{color:#e1e879}.contact-hero .eyebrow>span{background:#e1e879}.contact-badge{position:absolute;right:max(7vw,calc((100vw - 1210px)/2));bottom:-28px;z-index:4;width:260px;padding:20px 48px 19px 21px;background:#e1e879;color:#21392e;box-shadow:0 18px 38px #0f291f37;transform:rotate(2deg);border-radius:3px 20px 3px 3px}.contact-badge span{font-size:7px;letter-spacing:.16em;color:#64734c}.contact-badge b{display:block;margin-top:8px;font:600 17px/1.25 var(--display)}.contact-badge i{position:absolute;right:16px;bottom:16px;color:#bb5947;font-style:normal;font-size:17px}.contact-main{position:relative;z-index:2;padding-block:105px 110px;gap:90px}.contact-info{padding-top:21px}.contact-info h2,.inquiry h2{font-size:39px}.contact-info>p{line-height:1.9}.direct{transition:padding .2s,border-color .2s}.direct:hover{padding-left:9px;border-color:#bf5e4a}.direct small,.address small{color:#9b5749}.inquiry{padding:36px;background:linear-gradient(135deg,#eeefe7,#e4e8dd);border-radius:3px 25px 3px 3px;box-shadow:0 23px 55px #1b33251f}.inquiry h2{font-size:29px}.inquiry input:not([type=checkbox]),.inquiry select,.inquiry textarea{background:#faf9f3;border:1px solid #d1d9cc;border-radius:5px;padding:13px 14px;transition:border-color .2s,box-shadow .2s}.inquiry input:focus,.inquiry select:focus,.inquiry textarea:focus{border-color:#718844;box-shadow:0 0 0 3px #dfe87973}.inquiry button{margin-top:5px}.form-note{margin-top:12px}.contact-foot{background:radial-gradient(ellipse at 84% 0%,#345743 0%,#203e32 54%);border-top:1px solid #ffffff1c}.contact-foot>.wrap{padding-block:23px}.contact-foot span:first-child{color:#e0e879}.contact-hero+.contact-main{margin-top:-12px}
@media(max-width:800px){.contact-hero{height:420px}.contact-hero h1{font-size:63px}.contact-badge{right:24px;width:230px;bottom:-24px}.contact-main{padding-block:86px 76px;gap:25px}}
@media(max-width:520px){.contact-hero{height:390px}.contact-hero:after{inset:9px}.contact-hero h1{font-size:54px}.contact-hero-inner{padding-top:25px}.contact-badge{width:200px;padding:15px 40px 14px 15px;bottom:-22px;right:17px}.contact-badge b{font-size:14px}.contact-main{padding-block:75px 65px}.contact-info h2{font-size:32px}.inquiry{padding:23px 17px}.inquiry h2{font-size:24px}}
</style>

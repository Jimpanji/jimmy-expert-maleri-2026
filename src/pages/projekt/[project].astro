---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projectDetails } from '../../data/site';
export function getStaticPaths() { return projectDetails.map((project) => ({ params: { project: project.slug }, props: { project } })); }
const { project } = Astro.props;
const image = `https://www-static.expertmaleri.se/wp-content/uploads/2024/09/${project.image}`;
---
<SiteLayout title={`${project.title} | Expert Måleri`} description={`${project.short} Expert Måleris referensprojekt i ${project.location}.`}>
  <section class="project-detail-hero"><img src={image} alt={`${project.title} – ${project.short}`} fetchpriority="high"/><div class="detail-shade"></div><div class="wrap detail-hero-content"><a class="crumb" href="/projekt/">PROJEKT <span>/</span> {project.location.toUpperCase()}</a><span class="eyebrow light"><span></span> REFERENSPROJEKT · {project.location.toUpperCase()}</span><h1>{project.title}</h1><p>{project.short}</p></div><div class="detail-stamp"><span>EXPERT MÅLERI</span><b>Utfört arbete<br/>i {project.location}</b><i>✳</i></div></section>
  <section class="project-detail-body wrap"><aside><span class="eyebrow"><span></span> I KORTHET</span><dl><div><dt>Plats</dt><dd>{project.location}</dd></div><div><dt>Arbete</dt><dd>{project.short}</dd></div><div><dt>Utförare</dt><dd>H. Expert Måleri AB</dd></div></dl><a href="/kontakt/" class="project-contact-link">Diskutera ett liknande projekt <span>↗</span></a></aside><article><span class="eyebrow"><span></span> ETT URVAL UR VÅRT ARBETE</span><h2>Hantverk som tar<br/>hänsyn till <em>platsen.</em></h2><p>{project.short} Arbetet är en del av Expert Måleris referenser från Stockholm med omnejd, där vi bidrar med måleri, fönster- och fasadarbeten i olika typer av fastigheter.</p><figure><img src={image} alt={`${project.title}, ${project.location}`} loading="lazy" decoding="async"/><figcaption>{project.title} · {project.location}</figcaption></figure><p>Varje fastighet har sina egna förutsättningar. Arbetets omfattning och utförande planeras efter platsen och uppdraget.</p></article></section>
  <section class="project-next"><div class="wrap"><div><span class="eyebrow light"><span></span> FRÅN REFERENS TILL DITT PROJEKT</span><h2>Vad behöver<br/><em>din fastighet?</em></h2></div><a class="button button-lime" href="/kontakt/">Prata med oss <span>↗</span></a></div></section>
</SiteLayout>
<style>
.project-detail-hero{height:585px;position:relative;isolation:isolate;overflow:visible;background:#18372b;color:#fff}.project-detail-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 50%;z-index:-2;filter:saturate(.82)}.detail-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#112a21e8 0%,#112a219d 48%,#112a2118 100%),linear-gradient(0deg,#10291f70,transparent 40%)}.project-detail-hero:after{content:'';position:absolute;inset:15px;border:1px solid #ffffff35;pointer-events:none}.detail-hero-content{position:relative;padding-top:46px}.detail-hero-content .crumb{display:block;margin-bottom:87px;color:#d2dbd0;font-size:8px;letter-spacing:.16em}.detail-hero-content .crumb span{color:#e3eb83;padding:0 8px}.detail-hero-content h1{max-width:780px;font:600 clamp(46px,6vw,78px)/.98 var(--display);letter-spacing:-.065em;margin:21px 0 15px}.detail-hero-content>p{color:#d9e0d7;max-width:440px;font-size:13px;line-height:1.8}.detail-stamp{position:absolute;right:max(7vw,calc((100vw - 1200px)/2));bottom:-28px;z-index:2;width:236px;padding:19px 45px 18px 20px;background:#e1e879;color:#1e382c;box-shadow:0 20px 42px #0920164f;transform:rotate(2deg);border-radius:3px 20px 3px 3px}.detail-stamp span{font-size:7px;letter-spacing:.16em;color:#697543}.detail-stamp b{display:block;font:600 17px/1.25 var(--display);margin-top:8px}.detail-stamp i{position:absolute;right:16px;bottom:16px;font-style:normal;color:#b55645}.project-detail-body{display:grid;grid-template-columns:.72fr 1.28fr;gap:100px;padding-block:115px 126px}.project-detail-body aside{position:sticky;top:120px;height:max-content;padding:20px;background:#eceee5;border-left:2px solid #bd5e4a}.project-detail-body dl{margin:22px 0}.project-detail-body dl div{padding:13px 0;border-bottom:1px solid #d4dacf}.project-detail-body dt{font-size:8px;text-transform:uppercase;letter-spacing:.13em;color:#84914c}.project-detail-body dd{margin:6px 0 0;font-size:10px;line-height:1.55;color:#435349}.project-contact-link{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #d4dacf;padding-top:16px;font-size:9px;font-weight:700}.project-contact-link span{font-size:15px;color:#a95243}.project-detail-body article{max-width:720px}.project-detail-body article h2{font:500 clamp(40px,4.6vw,57px)/1 var(--display);letter-spacing:-.06em;margin:24px 0 20px}.project-detail-body article h2 em{font:400 .95em Georgia,serif;color:#a95243}.project-detail-body article>p{font-size:13px;line-height:1.9;color:#667168;max-width:650px}.project-detail-body figure{position:relative;margin:30px 0 27px;background:#e5e5dc;box-shadow:0 18px 40px #15271b1c;transform:rotate(-.6deg);border-radius:2px 22px 2px 2px;overflow:hidden}.project-detail-body figure img{display:block;width:auto;max-width:100%;height:auto;max-height:490px;margin-inline:auto}.project-detail-body figure figcaption{position:absolute;left:14px;bottom:14px;padding:8px 12px;background:#18382bd9;color:#fff;border-radius:99px;font-size:7px;letter-spacing:.12em;text-transform:uppercase}.project-next{padding:61px 0;background:radial-gradient(ellipse at 79% 15%,#345742 0%,#203e32 58%,#17382c 100%);color:white}.project-next>.wrap{display:flex;align-items:center;justify-content:space-between;gap:25px}.project-next h2{font:500 48px/.98 var(--display);letter-spacing:-.06em;margin:19px 0 0}.project-next h2 em{font:400 .95em Georgia,serif;color:#e2e97e}
@media(max-width:750px){.project-detail-hero{height:500px}.project-detail-body{grid-template-columns:1fr;gap:32px;padding-block:76px 90px}.project-detail-body aside{position:static;top:auto}.project-detail-body dl{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.project-detail-body dl div{border:0;border-top:1px solid #d4dacf}.project-detail-body dl dd{font-size:9px}.project-next{padding-block:50px}}
@media(max-width:520px){.project-detail-hero{height:420px}.project-detail-hero:after{inset:9px}.detail-hero-content{padding-top:26px}.detail-hero-content .crumb{margin-bottom:64px;font-size:7px}.detail-hero-content h1{font-size:45px}.detail-hero-content>p{font-size:11px}.detail-stamp{right:16px;bottom:-23px;width:192px;padding:14px 39px 13px 15px}.detail-stamp b{font-size:14px}.project-detail-body{padding-block:62px 72px;gap:24px}.project-detail-body aside{padding:16px}.project-detail-body dl{grid-template-columns:1fr 1fr}.project-detail-body dl div:nth-child(2){grid-column:span 2}.project-detail-body article h2{font-size:40px}.project-detail-body article>p{font-size:11px}.project-detail-body figure img{max-height:300px}.project-detail-body figure figcaption{left:8px;bottom:8px;font-size:6px}.project-next{padding-block:42px}.project-next>.wrap{display:block}.project-next h2{font-size:42px}.project-next .button{margin-top:22px}}
</style>
